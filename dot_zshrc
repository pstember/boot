# copypath function (replaces copypath plugin)
function copypath {
  print -n "${PWD}" | pbcopy
}

# copyfile function (replaces copyfile plugin)
function copyfile {
  [[ "$#" != 1 ]] && echo "Usage: copyfile <file>" && return 1
  [[ ! -f "$1" ]] && echo "$1 is not a file" && return 1
  cat "$1" | pbcopy
}

